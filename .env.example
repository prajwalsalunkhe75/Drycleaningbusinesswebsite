# MongoDB Connection String
MONGO_URI=mongodb://username:password@host:port/database?ssl=true&replicaSet=replica-set

# Server Port
PORT=3000

# Admin Credentials (Change these for production)
ADMIN_USER=admin
ADMIN_PASS=secure_password_change_in_production

# JWT Secret (Generate a strong random key for production - minimum 32 characters)
JWT_SECRET=your_super_secret_key_change_this_in_production

# Node Environment
NODE_ENV=development

# Allowed Origins (comma-separated) - Update with your actual domain
# Development: http://localhost:5173,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
